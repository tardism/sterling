Module imp_demo:host


/*Expressions and statements are unified into a single `expr` datatype.
  This is a minimal IMP variant for demonstrating side effects: there is
  no output (no print), no booleans, no while/if.  Everything an expr
  evaluates to is a `value`, and each evaluation may also update the env. */
expr ::= num(int)
       | minus(expr, expr)
       | inc(string)
       | name(string)
       | nil                          /* empty list expression */
       | cons(expr, expr)             /* cons cell expression */
       | index(string, expr)          /* arr[i] read */
       | assign(string, expr)          /* x = Env */
       | arrAssign(string, expr, expr) /* arr[i] = Env */
       | seq(expr, expr)               /* e1 ; e2 */
Projection expr :


value ::= intVal(int)
        | nilVal
        | consVal(value, value)
Projection value :


/* Find the first item associated with the key in an env list. */
Judgment lookup : [(string, value)] expr* value

K == Key
----------------------------------- [Lkp-Here]
lookup (K, Value)::Rest name(Key) Value


K != Key
lookup Rest name(Key) V
----------------------------------- [Lkp-Later]
lookup (K, Value)::Rest name(Key) V


/* List get: read element at index I from a cons-list value. */
Judgment listGet : value value* value

I == 0
------------------------------ [LG-Zero]
listGet consVal(H, T) intVal(I) H


I > 0
I - 1 = J
listGet T intVal(J) V
------------------------------ [LG-Succ]
listGet consVal(H, T) intVal(I) V


/* List set: replace element at index I in a cons-list, returning a new list. */
Judgment listSet : value value value* value

I == 0
------------------------------------------- [LS-Zero]
listSet consVal(H, T) intVal(I) V consVal(V, T)


I > 0
I - 1 = J
listSet T intVal(J) V T2
------------------------------------------- [LS-Succ]
listSet consVal(H, T) intVal(I) V consVal(H, T2)


Judgment eval : [(string, value)] expr* value [(string, value)]


----------------- [E-Num]
eval Env num(I) intVal(I) Env


/* Two competing rules for `minus` — the order in which the two
   operands are evaluated is unspecified, mirroring C's `foo(++x, x)`. */

eval Env A1 intVal(I1) Env2
eval Env2 A2 intVal(I2) Env3
I1 - I2 = I
----------------------- [E-Minus-LR]
eval Env minus(A1, A2) intVal(I) Env3

/*
eval Env A2 intVal(I2) Env2
eval Env2 A1 intVal(I1) Env3
I1 - I2 = I
----------------------- [E-Minus-RL]
eval Env minus(A1, A2) intVal(I) Env3
*/


/* Pre-increment: ++X reads X, returns X+1, prepends new binding. */
lookup Env name(X) intVal(Iv)
Iv + 1 = I
------------------------------ [E-inc]
eval Env inc(X) intVal(I) (X, intVal(I))::Env


lookup Env name(X) V
------------------ [E-Name]
eval Env name(X) V Env


------------------------------ [E-Nil]
eval Env nil nilVal Env


eval Env A1 V1 Env2
eval Env2 A2 V2 Env3
------------------------------ [E-Cons]
eval Env cons(A1, A2) consVal(V1, V2) Env3


/* arr[i] read: evaluate the index, look up the array, get the I-th element. */
eval Env IExpr intVal(I) Env2
lookup Env2 name(Arr) Lst
listGet Lst intVal(I) V
------------------------------ [E-Index]
eval Env index(Arr, IExpr) V Env2


eval Env A V Env2
------------------------------- [E-Assign]
eval Env assign(X, A) V (X, V)::Env2


/* arr[i] = e -- two competing rules for the unspecified order
   of evaluating the index versus the right-hand side. */

eval Env IExpr intVal(I) Env2
eval Env2 RHS V Env3
lookup Env3 name(Arr) Lst
listSet Lst intVal(I) V Lst2
------------------------------- [E-ArrAssign-LR]
eval Env arrAssign(Arr, IExpr, RHS) V (Arr, Lst2)::Env3

/*
eval Env RHS V Env2
eval Env2 IExpr intVal(I) Env3
lookup Env3 name(Arr) Lst
listSet Lst intVal(I) V Lst2
------------------------------- [E-ArrAssign-RL]
eval Env arrAssign(Arr, IExpr, RHS) V (Arr, Lst2)::Env3
*/

/* Sequencing: evaluate first, discard its value, evaluate second. */
eval Env E1 V1 Env2
eval Env2 E2x V2 Env3
------------------------ [E-Seq]
eval Env seq(E1, E2x) V2 Env3
