Module imp_demo:host

Function main : <Args : [string]> -> int {
   run(Args)
}


Function run : <Files : [string]> -> int {
   If null(Files)
   Then 0
   Else Let FResult := runFile(head(Files))
        In
          If FResult = 0
          Then run(tail(Files))
          Else FResult
}


Function runFile : <File : string> -> int {
   Let Contents := Read File
   In
   Let PSuccess, Prog, Errors := Parse e_top from Contents
   In
     If PSuccess
     Then
       Let Success := Derive {eval [] Prog V EnvOut} for Prog assigning []
       In
           
         If Success
         Then

           0
         Else

           1

     Else

       Print "Error parsing file " Before
       Print File Before
       Print "\n" Before
       Print Errors Before
       Print "\n" Before

       1
}
