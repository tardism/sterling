Module stlc:host


/*Syntax Constructors*/

type_stlc ::= arrow(type_stlc, type_stlc)
       | base

term ::= app(term, term)
       | abs(string, type_stlc, term)
       | var(string)



/*Judgments*/
Judgment typeOf : [(string, type_stlc)] term* type_stlc

/*Projection Types*/
Projection term : [(string, type_stlc)] /*ctx |- term ~~> term*/
Projection type_stlc :                  /*|- type_stlc ~~> type_stlc*/


/*Typing Rules*/

typeOf G T1 arrow(Ty11, Ty2)
typeOf G T2 Ty12
Ty11 == Ty12
--------------------------- [T-App]
typeOf G app(T1, T2) Ty2


typeOf (X, Ty1)::G Body Ty2
------------------------------------------ [T-Abs]
typeOf G abs(X, Ty1, Body) arrow(Ty1, Ty2)


lookup G X Ty
------------------ [T-Var]
typeOf G var(X) Ty
