Module imp_executable:host


/*Because we don't have Booleans built in, roll our own Boolean values*/
value ::= intVal(int)
        | trueVal
        | falseVal
        | nilVal
        | consVal(value, value)
Projection value :
/*Output from the program printing*/
output ::= emptyOutput
         | addOutput(output, value) /*snoc for appending always*/

Projection output :

Judgment appendOutput : output output* output

---------------------------- [AO-Empty]
appendOutput O1 emptyOutput O1


appendOutput O1 O2 O3
------------------------------------------------- [AO-Add]
appendOutput O1 addOutput(O2, V) addOutput(O3, V)


/* List get: read element at index I from a cons-list value. */
Judgment listGet : value value* value

I == 0
------------------------------ [LG-Zero]
listGet consVal(H, T) intVal(I) H


I > 0
I - 1 = J
listGet T intVal(J) V
------------------------------ [LG-Succ]
listGet consVal(H, T) intVal(I) V


/* List set: replace element at index I in a cons-list, returning a new list. */
/* second can just be INT!!!!! type */
Judgment listSet : value value value* value

I == 0
------------------------------------------- [LS-Zero]
listSet consVal(H, T)  intVal(I) V consVal(V, T)


I > 0
I - 1 = J
listSet T intVal(J) V T2
------------------------------------------- [LS-Succ]
listSet consVal(H, T) intVal(I) V consVal(H, T2)

Judgment eval_a : [(string, value)] a* value [(string, value)] output
Judgment eval_b : [(string, value)] b* value output
Judgment eval_c : [(string, value)] c* [(string, value)] output

/* Update an existing binding in the env (used by preInc).  Returns the new env. */
Judgment updateEnv : [(string, value)] string value* [(string, value)]

X == Y
------------------------------------------------- [UE-Hit]
updateEnv (Y, U)::Rest X V (X, V)::Rest

X != Y
updateEnv Rest X V Rest2
------------------------------------------------- [UE-Miss]
updateEnv (Y, U)::Rest X V (Y, U)::Rest2 


/* Find the first item associated with the key in an env list. */
Judgment lookup : [(string, value)] a* value

K == Key
----------------------------------- [Lkp-Here]
lookup (K, Value)::Rest name(Key) Value


K != Key
lookup Rest name(Key) V
----------------------------------- [Lkp-Later]
lookup (K, Value)::Rest name(Key) V

/*Check equality in a way appropriate to each value type*/

/* 
We should ban this way of declaring Judgment, Judgment val_eq : value* value
which only has one inputs. All judgement should have at least have 2 inputs.
 */

/* 

Judgment val_eq : value value* value

I1 == I2
-------------------------- [VE-Int-True]
val_eq intVal(I1) intVal(I2) trueVal

I1 != I2
-------------------------- [VE-Int-False]
val_eq intVal(I1) intVal(I2) falseVal


---------------------- [VE-True1]
val_eq trueVal trueVal trueVal


------------------------ [VE-True2]
val_eq falseVal falseVal trueVal


---------------------- [VE-False1]
val_eq trueVal falseVal falseVal


------------------------ [VE-False2]
val_eq falseVal trueVal falseVal
 */


/*Arithmetic Evaluation*/

----------------- [E-Num]
eval_a E num(I) intVal(I) E emptyOutput


eval_a E A1 intVal(I1) E2 O1
eval_a E2 A2 intVal(I2) E3 O2
I1 + I2 = I
appendOutput O1 O2 O
----------------------- [E-Plus]
eval_a E plus(A1, A2) intVal(I) E3 O


/* Two competing rules for `minus` -- the order in which the two operands are
   evaluated is unspecified (mirroring C's `foo(++x, x)` undefined behavior). */

eval_a E A1 intVal(I1) E2 O1
eval_a E2 A2 intVal(I2) E3 O2
I1 - I2 = I
appendOutput O1 O2 O
----------------------- [E-Minus-LR]
eval_a E minus(A1, A2) intVal(I) E3 O


/* Note OCaml doesn't support this way of writing non-deterministic rules
it will pop out compile error in utop */
/*
eval_a E A2 intVal(I2) E2 O2
eval_a E2 A1 intVal(I1) E3 O1
I1 - I2 = I
appendOutput O1 O2 O
----------------------- [E-Minus-RL]
eval_a E minus(A1, A2) intVal(I) E3 O
*/


/* Pre-increment: ++X reads X, writes X+1, returns X+1, mutates env. */
lookup E preInc(X) intVal(Iv)
Iv + 1 = I
------------------------------ [E-PreInc]
eval_a E preInc(X) intVal(I) (X, intVal(I))::E emptyOutput


lookup E name(X) I
------------------ [E-Name]
eval_a E name(X) I E emptyOutput


------------------------------ [E-NilA]
eval_a E nilA nilVal E emptyOutput


eval_a E A1 V1 E2 O1
eval_a E2 A2 V2 E3 O2
appendOutput O1 O2 O
------------------------------ [E-ConsA]
eval_a E consA(A1, A2) consVal(V1, V2) E3 O


/* arr[i] read: evaluate the index, look up the array, get the I-th element. */
eval_a E IExpr intVal(I) E2 O
lookup E2 name(Arr) Lst
listGet Lst intVal(I) V
------------------------------ [E-IndexA]
eval_a E indexA(Arr, IExpr) V E2 O




/*Boolean Evaluation*/

------------------- [E-True]
eval_b E true trueVal emptyOutput


--------------------- [E-False]
eval_b E false falseVal emptyOutput


eval_a E A1 intVal(I1) E2 O1
eval_a E2 A2 intVal(I2) E3 O2
I1 > I2
appendOutput O1 O2 O
------------------------------ [E-GreaterTrue]
eval_b E greater(A1, A2) trueVal O


eval_a E A1 intVal(I1) E2 O1
eval_a E2 A2 intVal(I2) E3 O2
I1 <= I2
appendOutput O1 O2 O
------------------------------ [E-GreaterFalse]
eval_b E greater(A1, A2) falseVal O


eval_a E A1 V1 E2 O1
eval_a E2 A2 V2 E3 O2
V1 == V2 
appendOutput O1 O2 O
------------------------- [E-EqTrue]
eval_b E eq(A1, A2) trueVal O


eval_a E A1 V1 E2 O1
eval_a E2 A2 V2 E3 O2
V1 != V2
appendOutput O1 O2 O
-------------------------- [E-EqFalse]
eval_b E eq(A1, A2) falseVal O


eval_b E B1 falseVal O
--------------------------- [E-AndFalse1]
eval_b E and(B1, B2) falseVal O


eval_b E B1 trueVal O1
eval_b E B2 falseVal O2
appendOutput O1 O2 O
--------------------------- [E-AndFalse2]
eval_b E and(B1, B2) falseVal O


eval_b E B1 trueVal O1
eval_b E B2 trueVal O2
appendOutput O1 O2 O
-------------------------- [E-AndTrue]
eval_b E and(B1, B2) trueVal O


eval_b E B1 trueVal O
------------------------- [E-OrTrue1]
eval_b E or(B1, B2) trueVal O


eval_b E B1 falseVal O1
eval_b E B2 trueVal O2
appendOutput O1 O2 O
------------------------- [E-OrTrue2]
eval_b E or(B1, B2) trueVal O


eval_b E B1 falseVal O1
eval_b E B2 falseVal O2
appendOutput O1 O2 O
-------------------------- [E-OrFalse]
eval_b E or(B1, B2) falseVal O




/*Command Evaluation*/

--------------- [E-Noop]
eval_c E noop E emptyOutput

eval_a E A V E2 O1
--------------------------[E-Print]
eval_c E printVal(A) E2 addOutput(O1, V)


eval_c E C1 E2 O1
eval_c E2 C2 E3 O2
appendOutput O1 O2 O
------------------------ [E-Seq]
eval_c E seq(C1, C2) E3 O


eval_a E A I E2 O
------------------------------- [E-Assign]
eval_c E assign(X, A) (X, I)::E2 O


/* arr[i] = e — two competing rules for the unspecified order
   of evaluating the index versus the right-hand side. */

eval_a E IExpr intVal(I) E2 O1
eval_a E2 RHS V E3 O2
lookup E3 name(Arr) Lst
listSet Lst intVal(I) V Lst2
appendOutput O1 O2 O
------------------------------- [E-ArrAssign-LR]
eval_c E arrAssign(Arr, IExpr, RHS) (Arr, Lst2)::E3 O

/*
eval_a E RHS V E2 O2
eval_a E2 IExpr intVal(I) E3 O1
lookup E3 name(Arr) Lst
listSet Lst intVal(I) V Lst2
appendOutput O1 O2 O
------------------------------- [E-ArrAssign-RL]
eval_c E arrAssign(Arr, IExpr, RHS) (Arr, Lst2)::E3 O
*/


eval_b E B trueVal O1
eval_c E C1 ERes O2
appendOutput O1 O2 O
----------------------------------- [E-IfThenElseTrue]
eval_c E ifThenElse(B, C1, C2) ERes O


eval_b E B falseVal O1
eval_c E C2 ERes O2
appendOutput O1 O2 O
----------------------------------- [E-IfThenElseFalse]
eval_c E ifThenElse(B, C1, C2) ERes O


eval_b E B falseVal O
---------------------- [E-WhileFalse]
eval_c E while(B, C) E O


eval_b E B trueVal O1
eval_c E C E2 O2
eval_c E2 while(B, C) E3 O3
appendOutput O1 O2 O4
appendOutput O4 O3 O
------------------------ [E-WhileTrue]
eval_c E while(B, C) E3 O


