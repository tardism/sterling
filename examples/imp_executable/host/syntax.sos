Module imp_executable:host

/*Arithmetic Expressions*/
a ::= num(int)
    | plus(a, a)
    | minus(a, a)
    | preInc(string)
    | name(string)
    | nilA                 /* empty list expression */
    | consA(a, a)          /* cons cell expression */
    | indexA(string, a)    /* arr[i] read */
Projection a :


/*Boolean Expressions*/
b ::= greater(a, a)
    | eq(a, a)
    | and(b, b)
    | or(b, b)
    | true
    | false
Projection b :


/*Statement Commands*/
c ::= noop
    | seq(c, c)
    | assign(string, a)
    | arrAssign(string, a, a)   /* arr[i] = e */
    | ifThenElse(b, c, c)
    | while(b, c)
    | printVal(a)
Projection c :

